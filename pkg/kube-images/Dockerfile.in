#
# Read-only payload volume that ships the upstream container images
# kube-init needs at first boot: KubeVirt, CDI, Longhorn, Multus and
# kube-vip. (The EVE-authored external-boot-image is not in here — it
# is assembled on the device by kube-init from the kernel and
# runx-initrd already present in the rootfs, see
# pkg/kube/kube-init/images/bootimage.go — which keeps this package
# independent of the kernel and xen-tools tags.)
#
# The payload is a standard OCI image layout (index.json, oci-layout,
# blobs/sha256/*) shipped as plain files: linuxkit unpacks volume
# images into the rootfs, and the rootfs binds this container's / at
# /images inside the kube container (see images/modifiers/hv/k.yq), so
# kube-init reads the layout there directly and registers the images
# with the k3s user-containerd without a network pull. No wrapper
# filesystem and no mount step on the device — the rootfs (squashfs-xz)
# compresses the payload as-is.
#
# LAYER_FORMAT=erofs (the default) converts every layer to a ready-made
# EROFS filesystem here, on the build host, so the device places blobs
# instead of running mkfs.erofs per layer on its single dom0 vCPU.
# LAYER_FORMAT=uncompressed keeps the previous behaviour (plain tar
# layers, converted on the device) as the fallback.

# The kube container is the source of the PATCHED mkfs.erofs (erofs-utils
# 1.9.2 + the usr-merge symlink fix). It cannot move here and out of
# pkg/kube: containerd's EROFS differ does exec.LookPath("mkfs.erofs") at
# plugin init and skips itself without it, and the device still converts
# every image that is NOT pre-packaged (user app images). Copying the
# binary means the build host converts with exactly the device's converter.
# Declare this passthrough stage BEFORE `build` so the RUN/COPY commands
# below execute inside `build` (the trap documented in pkg/kube/Dockerfile).
# hadolint ignore=DL3006
FROM KUBE_TAG AS kube

# hadolint ignore=DL3007
FROM alpine:3.22 AS build

ARG TARGETARCH
ARG LAYER_FORMAT=erofs

# skopeo pulls the upstream images; python3 runs the layer rewrite;
# erofs-utils brings the runtime libs mkfs.erofs needs (lz4, xz, zlib,
# uuid) — the binary itself is replaced by the patched one below. All
# discarded — only /out survives into the final stage.
# hadolint ignore=DL3018
RUN apk add --no-cache skopeo erofs-utils python3

# Alpine ships mkfs.erofs as /usr/bin/mkfs.erofs, which is where pkg/kube
# installs the patched build over it. /usr/local/sbin precedes /usr/bin in
# PATH, so this shadows apk's 1.8.6 for every mkfs.erofs call below.
# --version fails on 1.8.6, so it also asserts we got the patched binary.
COPY --from=kube /usr/bin/mkfs.erofs /usr/local/sbin/mkfs.erofs
RUN mkfs.erofs --version

WORKDIR /w
COPY upstream-images.list /w/upstream-images.list
COPY oci-rewrite-layers.py /w/oci-rewrite-layers.py

# Assemble a shared OCI image layout:
#   1) skopeo copy every upstream ref from the pinned list into a
#      single OCI layout (skopeo dedups blobs by digest within it).
#      skopeo sync can't target an OCI layout (docker/dir only), so
#      this is a copy per ref.
#   2) rewrite every layer per LAYER_FORMAT: to EROFS (default, so the
#      device places them) or to plain tar.
#   3) copy the layout out of the cache mount — /out is what survives
#      into the final stage, as plain files.
#
# BuildKit's --mount=type=cache persists /oci-cache across rebuilds,
# so bumping one image only re-pulls that image.
RUN --mount=type=cache,target=/oci-cache \
    set -eu; \
    mkdir -p /oci-cache/oci-layout /out; \
    while read -r ref; do \
        case "$ref" in ''|'#'*) continue;; esac; \
        # Pull strictly by the pinned digest (skopeo rejects tag@digest
        # refs); name the layout image after the digest-less name:tag,
        # which is what kube-init (refmap.go) and kubelet's pod specs
        # resolve by.
        name="${ref%%@*}"; \
        pull="$ref"; \
        case "$ref" in *@*) pull="${name%:*}@${ref#*@}";; esac; \
        dest=$(printf '%s' "$name" | tr '/:' '__'); \
        echo "[skopeo] $name ($pull)"; \
        skopeo copy --preserve-digests \
            "docker://$pull" \
            "oci:/oci-cache/oci-layout:$dest"; \
    done < /w/upstream-images.list; \
    # Ship the real-name ref list inside the image so kube-init can
    # map skopeo's sanitised OCI ref names back to the registry refs
    # kubelet expects (see loadRefMap in kube-init).
    cp /w/upstream-images.list /oci-cache/oci-layout/upstream-images.list; \
    echo "[rewrite] layers -> $LAYER_FORMAT"; \
    python3 /w/oci-rewrite-layers.py /oci-cache/oci-layout --format "$LAYER_FORMAT"; \
    cp -a /oci-cache/oci-layout/. /out/

FROM scratch
COPY --from=build /out/ /
